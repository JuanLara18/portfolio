{
  "$schema_note": "Single source of truth for the Juan Lara brand. Edit here, then run `npm run brand` in front/. Never copy these values by hand into other files.",
  "name": "Juan Lara",
  "version": "1.0.0",
  "approved": "2026-11-15",
  "verbal": {
    "role": "AI Engineer",
    "tagline": ["Frontier AI", "Engineered for production"],
    "strap": "AI Engineer · Production AI · Knowledge Systems",
    "url": "juanlara18.github.io/portfolio",
    "site": "https://juanlara18.github.io/portfolio"
  },
  "color": {
    "night": {
      "bg": "#05070A",
      "surface": "#0C1017",
      "border": "#1A2130",
      "text": "#E9E9E4",
      "muted": "#9AA2B1",
      "primary": "#22D3EE",
      "primaryHover": "#67E8F9",
      "harmonic": "#7C9CFF",
      "contrast": "#F5B544"
    },
    "day": {
      "bg": "#FFFFFF",
      "surface": "#F5F7FA",
      "border": "#E1E5EC",
      "text": "#0B1120",
      "muted": "#4B5568",
      "primary": "#0E7490",
      "primaryHover": "#155E75",
      "harmonic": "#3557D0",
      "contrast": "#B45309"
    }
  },
  "roles": {
    "bg": { "share": "60%", "use": "Page background." },
    "surface": { "share": "", "use": "Cards, code blocks, raised areas." },
    "border": { "share": "", "use": "Hairlines and dividers. Layers are separated by borders, not shadows." },
    "text": { "share": "", "use": "Body and headings. Night text is a dimmed white to avoid halation on black." },
    "muted": { "share": "", "use": "Secondary text, metadata, the Curiosities category." },
    "primary": { "share": "25%", "use": "Links, active state, labels, the first line of the hero, Field Notes." },
    "harmonic": { "share": "10%", "use": "Graph edges, chips, Research Notes, names in code, duotone mid-tones." },
    "contrast": { "share": "5% max", "use": "The logo node and the period that closes a title. Nothing else." }
  },
  "categories": {
    "field-notes": "primary",
    "research": "harmonic",
    "curiosities": "muted"
  },
  "duotone": {
    "note": "Shadows -> night bg, mid-tones -> harmonic at 42% over bg, highlights -> primary lightened 62% toward white.",
    "midMix": 0.42,
    "highlightMix": 0.62
  },
  "font": {
    "serif": { "family": "IBM Plex Serif", "fallback": "Georgia, 'Times New Roman', serif", "role": "Voice and name: titles, sections, the name." },
    "sans": { "family": "IBM Plex Sans", "fallback": "system-ui, -apple-system, 'Segoe UI', sans-serif", "role": "Reading and interface." },
    "mono": { "family": "IBM Plex Mono", "fallback": "ui-monospace, 'Cascadia Code', Consolas, monospace", "role": "Code, labels and metadata." },
    "googleFontsQuery": "family=IBM+Plex+Mono:ital,wght@0,400;0,500;0,600;1,400&family=IBM+Plex+Sans:ital,wght@0,400;0,500;0,600;0,700;1,400;1,600&family=IBM+Plex+Serif:ital,wght@0,400;0,500;0,600;1,400;1,600&display=swap"
  },
  "type": [
    { "name": "display", "font": "serif", "style": "italic", "weight": 600, "size": "3.5rem", "leading": 1.05, "tracking": "-0.02em", "use": "Hero tagline" },
    { "name": "title", "font": "serif", "style": "italic", "weight": 600, "size": "2.5rem", "leading": 1.1, "tracking": "-0.015em", "use": "Page and post titles" },
    { "name": "section", "font": "serif", "style": "normal", "weight": 600, "size": "1.75rem", "leading": 1.2, "tracking": "-0.01em", "use": "Section headings, card titles" },
    { "name": "name", "font": "serif", "style": "normal", "weight": 500, "size": "inherit", "leading": 1, "tracking": "-0.012em", "use": "The name. Never italic." },
    { "name": "body", "font": "sans", "style": "normal", "weight": 400, "size": "1.125rem", "leading": 1.7, "tracking": "0", "use": "Long-form reading, 60-72 characters per line" },
    { "name": "ui", "font": "sans", "style": "normal", "weight": 500, "size": "0.875rem", "leading": 1.4, "tracking": "0", "use": "Navigation, buttons, controls" },
    { "name": "label", "font": "mono", "style": "normal", "weight": 500, "size": "0.75rem", "leading": 1.4, "tracking": "0.12em", "use": "Uppercase labels and metadata", "uppercase": true },
    { "name": "code", "font": "mono", "style": "normal", "weight": 400, "size": "0.875rem", "leading": 1.6, "tracking": "0", "use": "Code blocks and inline code" }
  ],
  "logo": {
    "grid": 48,
    "regular": { "path": "M25 9V28C25 34.6 20.5 38 15 38", "stroke": 4.2, "top": [25, 9], "end": [14, 38], "node": [35.2, 37], "inkRadius": 4.6, "nodeRadius": 5.4 },
    "small": { "path": "M26 9.5V27C26 34 21.5 38 14 38", "stroke": 6, "top": [26, 9.5], "end": [12.5, 38], "node": [38.5, 37.5], "inkRadius": 6, "nodeRadius": 6, "note": "Optical cut for 16-32 px" },
    "lockup": { "symbolScale": 1.12, "gap": 0.30, "nameTracking": -0.012, "note": "Symbol box = 1.12 x font size; gap = 0.30 x font size; clear space = node diameter" },
    "minimumSize": { "lockupPx": 18, "symbolPx": 16 }
  },
  "formats": {
    "og": [1200, 630],
    "linkedinBanner": [1584, 396],
    "githubSocial": [1280, 640],
    "appleTouch": 180,
    "pwa": [192, 512],
    "favicon": [16, 32, 48]
  }
}
